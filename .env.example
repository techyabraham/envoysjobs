# Local Docker Compose defaults. Change secrets before any shared deployment.
POSTGRES_PASSWORD=postgres
JWT_SECRET=local-only-change-this-jwt-secret
NEXTAUTH_SECRET=local-only-change-this-nextauth-secret
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Optional local development providers
MAIL_PROVIDER=console
MAIL_FROM=EnvoysJobs <no-reply@envoysjobs.com>
RESEND_API_KEY=
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional S3-compatible storage. Uploads use local disk in development.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=envoysjobs
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

JOBS_IMPORT_ENABLED=false
JSEARCH_API_KEY=
